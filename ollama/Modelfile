# Modelfile for the fine-tuned ATTACK-Analyst model.
# 1) Put the exported GGUF (Q8_0) next to this file and keep the name below, or edit the FROM line.
# 2) Run:  ollama create attack-analyst -f Modelfile
# Studio's auto-generated Modelfile set temperature 1.5. This one pins the Llama 3 chat template and a low temperature.
FROM ./Llama-3.2-3B-Instruct.Q8_0.gguf

TEMPLATE """<|start_header_id|>system<|end_header_id|>

Cutting Knowledge Date: December 2023
Today Date: 03 October 2026

{{ .System }}<|eot_id|>{{ range .Messages }}{{ if eq .Role "user" }}<|start_header_id|>user<|end_header_id|>

{{ .Content }}<|eot_id|><|start_header_id|>assistant<|end_header_id|>

{{ else if eq .Role "assistant" }}{{ .Content }}<|eot_id|>{{ end }}{{ end }}"""

SYSTEM """You are ATTACK-Analyst, a threat-mapping specialist for the MITRE ATT&CK Enterprise matrix. Be precise and never invent technique IDs or facts. When REFERENCE DOCUMENTS are provided, answer only from them and cite the source files."""

PARAMETER temperature 0.1
PARAMETER top_p 0.9
PARAMETER num_ctx 4096
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
